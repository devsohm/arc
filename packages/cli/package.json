{
	"name": "@arc/cli",
	"version": "0.1.0-rc.1",
	"private": true,
	"type": "module",
	"description": "Terminal agent application built on independent runtime libraries.",
	"main": "./dist/sdk.js",
	"types": "./dist/sdk.d.ts",
	"exports": {
		".": {
			"source": "./src/sdk.ts",
			"types": "./dist/sdk.d.ts",
			"import": "./dist/sdk.js",
			"default": "./dist/sdk.js"
		},
		"./interactive": {
			"source": "./src/modes/interactive/interactive-mode.ts",
			"types": "./dist/modes/interactive/interactive-mode.d.ts",
			"import": "./dist/modes/interactive/interactive-mode.js",
			"default": "./dist/modes/interactive/interactive-mode.js"
		}
	},
	"bin": {
		"arc": "./dist/cli.js"
	},
	"files": [
		"dist",
		"docs",
		"README.md"
	],
	"scripts": {
		"build": "tsc -p tsconfig.json"
	},
	"dependencies": {
		"@arc/ai": "0.1.0-rc.1",
		"@arc/codemode": "0.1.0-rc.1",
		"@arc/durable": "0.1.0-rc.1",
		"@arc/mcp": "0.1.0-rc.1",
		"@arc/tui": "0.1.0-rc.1",
		"chalk": "6.0.1",
		"diff": "9.0.0",
		"grok-mermaid": "0.2.3",
		"highlight.js": "11.12.0",
		"minimatch": "10.2.6",
		"proper-lockfile": "4.1.2",
		"typebox": "1.4.3",
		"yaml": "2.9.1"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"license": "MIT"
}
